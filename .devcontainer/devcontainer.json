{
  "name": "panelcast",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "17" }
  },
  "postCreateCommand": "pip install -e '.[local,dev]'",
  "hostRequirements": { "memories": "8gb" },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "databricks.databricks"]
    }
  }
}
